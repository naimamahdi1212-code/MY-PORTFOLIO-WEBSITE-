        <h4>Call the Floor</h4>
        <p>+254 700 112 233<br>Mon–Sat, 8am–6pm</p>
      </div>
      <div class="contact-card reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M3 7l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"/></svg></div>
        <h4>Email Us</h4>
        <p>orders@naimascompany.com<br>Replies within 24 hours</p>
      </div>
      <div class="contact-card reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 21s-7-6.1-7-11a7 7 0 0114 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
        <h4>Visit the Garage</h4>
        <p>14 Jua Kali Lane, Industrial Area<br>Nairobi, Kenya</p>
      </div>
    </div>
    <div class="contact-map reveal">
      <img src="https://images.unsplash.com/photo-1524678606370-a47ad25cb82a?q=80&w=1400&auto=format&fit=crop" alt="Aerial street map style view">
      <div class="pin"><div class="pin-dot"></div><span>Naimas Company · Industrial Area</span></div>
    </div>
  </div>
</section>

<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo">
          <div class="logo-badge"><span>N</span></div>
          <div class="logo-text">Naimas<small>Motor &amp; Custom Co.</small></div>
        </div>
        <p>Custom BMW, Mercedes, and motorcycle builds — spec'd, fabricated, and delivered from our floor to yours.</p>
        <div class="social-row">
          <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
          <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M14 9h3V6h-3a3 3 0 00-3 3v2H8v3h3v6h3v-6h3l1-3h-4V9z"/></svg></a>
          <a href="#" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M14 3v10.5a3.5 3.5 0 11-3-3.46M14 3a5 5 0 005 5"/></svg></a>
        </div>
