<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Naimas Company — Built to Order</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#F4E9D8;
    --cream-2:#ECDDC4;
    --paper:#FBF5EA;
    --brown-deep:#241509;
    --brown:#3B2416;
    --brown-mid:#6E4A31;
    --brown-line:rgba(36,21,9,0.15);
    --pink:#C24463;
    --pink-deep:#9E2F4C;
    --pink-soft:#EFC2CC;
    --copper:#B9793F;
    --copper-light:#DDA765;
    --cream-rgb:244,233,216;
    --shadow: 0 20px 45px -20px rgba(36,21,9,0.45);
    --ease: cubic-bezier(.22,.9,.32,1);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--cream);
    color:var(--brown-deep);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--pink);color:var(--paper);}

  h1,h2,h3,h4{font-family:'Fraunces',serif;font-weight:600;letter-spacing:-0.01em;color:var(--brown-deep);}
  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:0.72rem;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--pink-deep);
    display:flex;
    align-items:center;
    gap:0.6rem;
  }
  .eyebrow::before{content:"";width:22px;height:1px;background:var(--pink-deep);display:inline-block;}
  .container{max-width:1240px;margin:0 auto;padding:0 6vw;}
  a{color:inherit;text-decoration:none;}
  img{display:block;max-width:100%;}

  /* reveal on scroll */
  .reveal{opacity:0;transform:translateY(28px);transition:opacity 0.9s var(--ease), transform 0.9s var(--ease);}
  .reveal.in{opacity:1;transform:translateY(0);}
  .reveal-scale{opacity:0;transform:scale(0.94);transition:opacity 0.9s var(--ease), transform 0.9s var(--ease);}
  .reveal-scale.in{opacity:1;transform:scale(1);}
  @media (prefers-reduced-motion: reduce){
    .reveal,.reveal-scale{transition:none;opacity:1;transform:none;}
    *{animation:none !important;}
  }

  /* ---------- NAV ---------- */
  header{
    position:fixed;top:0;left:0;right:0;z-index:1000;
    padding:1.1rem 6vw;
    display:flex;align-items:center;justify-content:space-between;
    background:rgba(244,233,216,0.72);
    backdrop-filter:blur(14px);
    border-bottom:1px solid transparent;
    transition:border-color 0.4s ease, background 0.4s ease;
  }
  header.scrolled{border-bottom-color:var(--brown-line);background:rgba(244,233,216,0.92);}
  .logo{display:flex;align-items:center;gap:0.7rem;}
  .logo-badge{
    width:38px;height:38px;border-radius:50%;
    background:conic-gradient(from 220deg,var(--copper-light),var(--pink),var(--copper),var(--copper-light));
    display:flex;align-items:center;justify-content:center;
    box-shadow: inset 0 0 0 3px var(--paper), 0 4px 10px rgba(36,21,9,0.35);
  }
  .logo-badge span{font-family:'Fraunces',serif;font-weight:700;font-size:0.95rem;color:var(--brown-deep);}
  .logo-text{font-family:'Fraunces',serif;font-weight:700;font-size:1.15rem;letter-spacing:-0.01em;}
  .logo-text small{display:block;font-family:'JetBrains Mono',monospace;font-weight:400;font-size:0.6rem;letter-spacing:0.24em;color:var(--brown-mid);text-transform:uppercase;}

  nav ul{list-style:none;display:flex;gap:2.1rem;}
  nav a{
    font-size:0.88rem;font-weight:500;color:var(--brown);position:relative;padding:0.2rem 0;
  }
  nav a::after{
    content:"";position:absolute;left:0;bottom:-2px;width:0;height:1.5px;background:var(--pink);transition:width 0.35s var(--ease);
  }
  nav a:hover::after{width:100%;}
  .nav-links{display:flex;}
  .nav-cta{
    padding:0.6rem 1.3rem;border-radius:100px;
    background:var(--brown-deep);color:var(--cream) !important;
    font-size:0.82rem;font-weight:600;
    transition:transform 0.3s var(--ease), background 0.3s ease;
  }
  .nav-cta:hover{transform:translateY(-2px);background:var(--pink-deep);}
  .menu-toggle{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px;}
  .menu-toggle span{width:24px;height:2px;background:var(--brown-deep);border-radius:2px;}

  /* ---------- BUTTONS ---------- */
  .btn{
    display:inline-flex;align-items:center;gap:0.6rem;
    padding:0.95rem 1.9rem;border-radius:100px;
    font-weight:600;font-size:0.92rem;
    border:1px solid transparent;cursor:pointer;
    transition:transform 0.3s var(--ease), box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
  }
  .btn-primary{background:var(--pink);color:var(--paper);box-shadow:0 14px 30px -12px rgba(194,68,99,0.65);}
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 20px 36px -12px rgba(194,68,99,0.75);background:var(--pink-deep);}
  .btn-outline{background:transparent;border-color:var(--brown-deep);color:var(--brown-deep);}
  .btn-outline:hover{background:var(--brown-deep);color:var(--cream);transform:translateY(-3px);}
  .btn-ghost-dark{background:rgba(251,245,234,0.1);border-color:rgba(251,245,234,0.4);color:var(--paper);}
  .btn-ghost-dark:hover{background:var(--paper);color:var(--brown-deep);transform:translateY(-3px);}
  .btn svg{width:16px;height:16px;transition:transform 0.3s var(--ease);}
  .btn:hover svg{transform:translateX(3px);}

  section{position:relative;}
  .section-pad{padding:7.5rem 0;}
  .section-head{max-width:640px;margin-bottom:3.4rem;}
  .section-head h2{font-size:clamp(2rem,4vw,2.9rem);margin-top:0.9rem;line-height:1.08;}
  .section-head p{margin-top:1.1rem;font-size:1.05rem;color:var(--brown-mid);line-height:1.6;}

  /* ---------- HERO ---------- */
  .hero{
    min-height:100vh;display:flex;align-items:center;
    padding-top:6rem;
    background:
      radial-gradient(circle at 85% 12%, rgba(194,68,99,0.16), transparent 45%),
      radial-gradient(circle at 8% 90%, rgba(185,121,63,0.22), transparent 40%),
      var(--cream);
    position:relative;overflow:hidden;
  }
  .hero-grid{
    display:grid;grid-template-columns:1.05fr 0.95fr;gap:3rem;align-items:center;
    width:100%;
  }
  .hero-copy .eyebrow{margin-bottom:1.4rem;}
  .hero h1{
    font-size:clamp(2.6rem,6vw,4.4rem);
    line-height:0.98;
    font-weight:600;
  }
  .hero h1 em{
    font-style:italic;font-weight:300;color:var(--pink-deep);
    position:relative;
  }
  .hero-copy p.lede{
    margin-top:1.6rem;font-size:1.15rem;color:var(--brown-mid);max-width:480px;line-height:1.65;
  }
  .hero-actions{display:flex;gap:1rem;margin-top:2.6rem;flex-wrap:wrap;}
  .hero-stats{
    display:flex;gap:2.4rem;margin-top:3.4rem;padding-top:2rem;border-top:1px solid var(--brown-line);
  }
  .hero-stats div strong{font-family:'Fraunces',serif;font-size:1.9rem;display:block;color:var(--brown-deep);}
  .hero-stats div span{font-size:0.78rem;color:var(--brown-mid);font-family:'JetBrains Mono',monospace;letter-spacing:0.03em;}

  .hero-visual{position:relative;height:560px;}
  .ticket-frame{
    position:absolute;border-radius:22px;overflow:hidden;
    box-shadow:var(--shadow);
    border:1px solid rgba(255,255,255,0.25);
  }
  .ticket-frame img{width:100%;height:100%;object-fit:cover;}
  .frame-main{width:78%;height:70%;top:0;right:0;z-index:3;animation:float1 7s ease-in-out infinite;}
  .frame-second{width:56%;height:46%;bottom:0;left:0;z-index:2;animation:float2 8s ease-in-out infinite;}
  .badge-float{
    position:absolute;bottom:8%;right:6%;z-index:4;
    background:var(--paper);border-radius:16px;padding:0.9rem 1.2rem;
    box-shadow:var(--shadow);display:flex;align-items:center;gap:0.7rem;
    animation:float3 6s ease-in-out infinite;
  }
  .badge-float .dot{width:9px;height:9px;border-radius:50%;background:#4caf6b;box-shadow:0 0 0 4px rgba(76,175,107,0.2);}
  .badge-float span{font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--brown);}
  @keyframes float1{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
  @keyframes float2{0%,100%{transform:translateY(0)}50%{transform:translateY(12px)}}
  @keyframes float3{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-8px) rotate(-1deg)}}

  .marquee-wrap{
    border-top:1px solid var(--brown-line);border-bottom:1px solid var(--brown-line);
    background:var(--cream-2);padding:1.1rem 0;overflow:hidden;
  }
  .marquee{display:flex;gap:3.5rem;white-space:nowrap;width:max-content;animation:scroll 26s linear infinite;}
  .marquee span{font-family:'JetBrains Mono',monospace;font-size:0.82rem;letter-spacing:0.14em;color:var(--brown-mid);text-transform:uppercase;}
  .marquee span em{color:var(--pink-deep);font-style:normal;}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ---------- ABOUT ---------- */
  .about{background:var(--cream);}
  .about-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:4rem;align-items:center;}
  .about-gallery{position:relative;height:420px;}
  .about-gallery img{
    position:absolute;border-radius:18px;object-fit:cover;box-shadow:var(--shadow);border:6px solid var(--paper);
  }
  .ag-1{width:62%;height:78%;top:0;left:0;z-index:2;}
  .ag-2{width:52%;height:52%;bottom:0;right:0;z-index:3;}
  .about-copy .stamp{
    display:inline-block;font-family:'JetBrains Mono',monospace;font-size:0.7rem;letter-spacing:0.2em;
    color:var(--copper);border:1px solid var(--copper);padding:0.3rem 0.7rem;border-radius:100px;text-transform:uppercase;
  }
  .about-copy h2{margin-top:1rem;font-size:clamp(2rem,3.6vw,2.7rem);line-height:1.1;}
  .about-copy p{margin-top:1.2rem;color:var(--brown-mid);line-height:1.7;font-size:1.02rem;}
  .about-list{margin-top:2rem;display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;}
  .about-list li{list-style:none;display:flex;gap:0.7rem;align-items:flex-start;font-size:0.92rem;color:var(--brown);}
  .about-list li::before{content:"✓";color:var(--pink);font-weight:700;margin-top:0.1rem;}

  /* ---------- TICKET CARD (signature element) ---------- */
  .ticket{
    background:var(--paper);
    border-radius:20px;
    position:relative;
    box-shadow:var(--shadow);
    overflow:hidden;
    display:flex;flex-direction:column;
    transition:transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .ticket:hover{transform:translateY(-10px);box-shadow:0 30px 55px -18px rgba(36,21,9,0.5);}
  .ticket-photo{height:220px;position:relative;overflow:hidden;}
  .ticket-photo img{width:100%;height:100%;object-fit:cover;transition:transform 0.7s var(--ease);}
  .ticket:hover .ticket-photo img{transform:scale(1.08);}
  .ticket-tag{
    position:absolute;top:14px;left:14px;background:var(--brown-deep);color:var(--cream);
    font-family:'JetBrains Mono',monospace;font-size:0.68rem;letter-spacing:0.1em;text-transform:uppercase;
    padding:0.35rem 0.7rem;border-radius:100px;
  }
  .ticket-body{padding:1.5rem 1.6rem 1.7rem;position:relative;}
  .ticket-body::before{
    content:"";position:absolute;top:-1px;left:0;right:0;height:1px;
    background-image:repeating-linear-gradient(to right, var(--brown-line) 0 8px, transparent 8px 16px);
  }
  .ticket-perf{
    position:absolute;top:-10px;left:0;right:0;height:20px;
    background-image:radial-gradient(circle 6px, var(--cream) 6px, transparent 7px);
    background-size:26px 20px;background-repeat:repeat-x;background-position:10px center;
  }
  .ticket-row{display:flex;justify-content:space-between;align-items:flex-start;gap:0.6rem;}
  .ticket-row h3{font-size:1.2rem;}
  .ticket-price{font-family:'JetBrains Mono',monospace;color:var(--pink-deep);font-weight:700;white-space:nowrap;font-size:0.95rem;}
  .ticket-body p{margin-top:0.6rem;font-size:0.9rem;color:var(--brown-mid);line-height:1.55;}
  .ticket-specs{display:flex;gap:1rem;margin-top:1.1rem;flex-wrap:wrap;}
  .ticket-specs span{
    font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--brown);background:var(--cream-2);
    padding:0.3rem 0.6rem;border-radius:6px;
  }
  .ticket-cta{
    margin-top:1.3rem;display:flex;align-items:center;gap:0.4rem;
    font-size:0.85rem;font-weight:600;color:var(--pink-deep);
  }
  .ticket-cta svg{width:14px;height:14px;transition:transform 0.3s var(--ease);}
  .ticket:hover .ticket-cta svg{transform:translateX(4px);}

  .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.8rem;}
  .grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;}

  /* ---------- FEATURED (dark band) ---------- */
  .featured{
    background:var(--brown-deep);color:var(--cream);
  }
  .featured .eyebrow{color:var(--copper-light);}
  .featured .eyebrow::before{background:var(--copper-light);}
  .featured .section-head h2{color:var(--cream);}
  .featured .section-head p{color:rgba(244,233,216,0.68);}
  .featured .ticket{background:#2E1B0F;}
  .featured .ticket-body::before{background-image:repeating-linear-gradient(to right, rgba(244,233,216,0.15) 0 8px, transparent 8px 16px);}
  .featured .ticket-perf{background-image:radial-gradient(circle 6px, var(--brown-deep) 6px, transparent 7px);}
  .featured .ticket-row h3{color:var(--cream);}
  .featured .ticket-body p{color:rgba(244,233,216,0.62);}
  .featured .ticket-specs span{background:rgba(244,233,216,0.08);color:rgba(244,233,216,0.85);}

  /* ---------- SUBLINE BLOCKS: BMW / Mercedes / Moto ---------- */
  .split{display:grid;grid-template-columns:1fr 1fr;align-items:center;}
  .split.reverse .split-media{order:2;}
  .split-media{position:relative;height:520px;overflow:hidden;}
  .split-media img{width:100%;height:100%;object-fit:cover;}
  .split-media::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(36,21,9,0) 55%, rgba(36,21,9,0.55));
  }
  .split-caption{
    position:absolute;left:2rem;bottom:2rem;color:var(--paper);z-index:2;
  }
  .split-caption .eyebrow{color:var(--copper-light);}
  .split-caption .eyebrow::before{background:var(--copper-light);}
  .split-copy{padding:5rem 6vw;}
  .split-copy h2{font-size:clamp(2rem,3.6vw,2.6rem);margin-top:0.9rem;line-height:1.1;}
  .split-copy p{margin-top:1.1rem;color:var(--brown-mid);line-height:1.7;font-size:1.02rem;max-width:480px;}
  .spec-strip{display:flex;gap:0;margin-top:2rem;border:1px solid var(--brown-line);border-radius:14px;overflow:hidden;}
  .spec-strip div{flex:1;padding:1rem 1.1rem;border-right:1px solid var(--brown-line);}
  .spec-strip div:last-child{border-right:none;}
  .spec-strip strong{display:block;font-family:'JetBrains Mono',monospace;font-size:1.05rem;color:var(--pink-deep);}
  .spec-strip span{font-size:0.72rem;color:var(--brown-mid);text-transform:uppercase;letter-spacing:0.06em;}
  .split-copy .btn{margin-top:2.2rem;}

  .bmw-band{background:var(--cream-2);}
  .merc-band{background:var(--cream);}
  .moto-band{background:var(--cream-2);}

  /* moto strip gallery */
  .moto-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin-top:1rem;}
  .moto-gallery figure{border-radius:16px;overflow:hidden;position:relative;height:240px;box-shadow:var(--shadow);}
  .moto-gallery img{width:100%;height:100%;object-fit:cover;transition:transform 0.6s var(--ease);}
  .moto-gallery figure:hover img{transform:scale(1.1) rotate(0.5deg);}
  .moto-gallery figcaption{
    position:absolute;left:0.9rem;bottom:0.8rem;color:var(--paper);font-family:'JetBrains Mono',monospace;
    font-size:0.72rem;letter-spacing:0.06em;background:rgba(36,21,9,0.55);padding:0.3rem 0.6rem;border-radius:100px;
  }

  /* ---------- PRICING ---------- */
  .pricing{background:var(--brown-deep);color:var(--cream);}
  .pricing .eyebrow{color:var(--copper-light);}
  .pricing .eyebrow::before{background:var(--copper-light);}
  .pricing .section-head h2{color:var(--cream);}
  .pricing .section-head p{color:rgba(244,233,216,0.68);}
  .price-card{
    background:#2E1B0F;border-radius:20px;padding:2.4rem 2rem;position:relative;
    border:1px solid rgba(244,233,216,0.1);
    transition:transform 0.4s var(--ease), border-color 0.4s ease;
  }
  .price-card:hover{transform:translateY(-8px);border-color:var(--pink);}
  .price-card.featured{background:linear-gradient(160deg,#4a2136,#2E1B0F 60%);border-color:var(--pink);}
  .price-card .ribbon{
    position:absolute;top:-1px;right:1.6rem;background:var(--pink);color:var(--paper);
    font-family:'JetBrains Mono',monospace;font-size:0.64rem;letter-spacing:0.08em;text-transform:uppercase;
    padding:0.4rem 0.8rem;border-radius:0 0 8px 8px;
  }
  .price-card .plan-name{font-family:'JetBrains Mono',monospace;font-size:0.75rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--copper-light);}
  .price-card h3{color:var(--cream);font-size:1.5rem;margin-top:0.6rem;}
  .price-card .amount{display:flex;align-items:baseline;gap:0.4rem;margin-top:1.1rem;}
  .price-card .amount b{font-family:'Fraunces',serif;font-size:2.8rem;font-weight:600;}
  .price-card .amount span{color:rgba(244,233,216,0.55);font-size:0.85rem;}
  .price-card ul{list-style:none;margin-top:1.6rem;display:flex;flex-direction:column;gap:0.75rem;}
  .price-card ul li{font-size:0.9rem;color:rgba(244,233,216,0.78);display:flex;gap:0.6rem;}
  .price-card ul li::before{content:"—";color:var(--pink);}
  .price-card .btn{width:100%;justify-content:center;margin-top:2rem;}

  /* ---------- TESTIMONIALS ---------- */
  .testimonials{background:var(--cream);}
  .test-track{
    display:flex;gap:1.6rem;overflow-x:auto;padding-bottom:1rem;scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
  }
  .test-track::-webkit-scrollbar{height:6px;}
  .test-track::-webkit-scrollbar-thumb{background:var(--brown-line);border-radius:4px;}
  .test-card{
    scroll-snap-align:start;min-width:340px;max-width:340px;background:var(--paper);border-radius:20px;
    padding:2.1rem;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:1.2rem;
  }
  .stars{display:flex;gap:0.2rem;color:var(--copper);}
  .stars svg{width:16px;height:16px;fill:var(--copper);}
  .test-card p{color:var(--brown);line-height:1.65;font-size:0.97rem;}
  .test-person{display:flex;align-items:center;gap:0.8rem;margin-top:auto;}
  .test-avatar{
    width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--pink),var(--copper));
    display:flex;align-items:center;justify-content:center;color:var(--paper);font-family:'Fraunces',serif;font-weight:700;
  }
  .test-person strong{display:block;font-size:0.92rem;}
  .test-person span{font-size:0.78rem;color:var(--brown-mid);}

  /* ---------- ORDERS ---------- */
  .orders{
    background:linear-gradient(135deg, var(--pink-deep), var(--brown-deep) 70%);
    color:var(--paper);position:relative;overflow:hidden;
  }
  .orders::before{
    content:"";position:absolute;width:600px;height:600px;border-radius:50%;
    background:radial-gradient(circle, rgba(255,255,255,0.08), transparent 70%);
    top:-200px;right:-150px;
  }
  .orders-grid{display:grid;grid-template-columns:1fr 1fr;gap:3.5rem;align-items:center;position:relative;z-index:2;}
  .orders .eyebrow{color:var(--copper-light);}
  .orders .eyebrow::before{background:var(--copper-light);}
  .orders h2{color:var(--paper);font-size:clamp(2rem,3.8vw,2.8rem);margin-top:0.9rem;line-height:1.1;}
  .orders p.lede{margin-top:1.1rem;color:rgba(251,245,234,0.75);font-size:1.05rem;line-height:1.65;max-width:460px;}
  .order-steps{margin-top:2rem;display:flex;flex-direction:column;gap:1rem;}
  .order-steps div{display:flex;gap:1rem;align-items:flex-start;}
  .order-steps .num{
    font-family:'JetBrains Mono',monospace;font-size:0.8rem;color:var(--brown-deep);background:var(--copper-light);
    width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;
  }
  .order-steps strong{display:block;font-size:0.95rem;}
  .order-steps span{font-size:0.85rem;color:rgba(251,245,234,0.65);}

  .order-form{
    background:var(--paper);border-radius:22px;padding:2.4rem;box-shadow:0 30px 60px -20px rgba(0,0,0,0.5);color:var(--brown-deep);
  }
  .order-form h3{font-size:1.3rem;}
  .order-form p.sub{color:var(--brown-mid);font-size:0.88rem;margin-top:0.4rem;}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:0.9rem;margin-top:1.4rem;}
  .form-field{display:flex;flex-direction:column;gap:0.4rem;grid-column:span 1;}
  .form-field.full{grid-column:span 2;}
  .form-field label{font-size:0.76rem;font-family:'JetBrains Mono',monospace;letter-spacing:0.05em;color:var(--brown-mid);text-transform:uppercase;}
  .form-field input,.form-field select,.form-field textarea{
    padding:0.8rem 0.9rem;border-radius:10px;border:1px solid var(--brown-line);background:var(--cream);
    font-family:'Inter',sans-serif;font-size:0.92rem;color:var(--brown-deep);outline:none;
    transition:border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .form-field input:focus,.form-field select:focus,.form-field textarea:focus{
    border-color:var(--pink);box-shadow:0 0 0 3px rgba(194,68,99,0.15);
  }
  .order-form .btn{width:100%;justify-content:center;margin-top:1.6rem;}
  .form-note{margin-top:0.9rem;font-size:0.76rem;color:var(--brown-mid);text-align:center;}

  /* ---------- FAQ ---------- */
  .faq{background:var(--cream);}
  .faq-wrap{max-width:820px;}
  .faq-item{
    border-bottom:1px solid var(--brown-line);
  }
  .faq-q{
    width:100%;background:none;border:none;text-align:left;padding:1.5rem 0;
    display:flex;justify-content:space-between;align-items:center;cursor:pointer;gap:1rem;
  }
  .faq-q h4{font-size:1.05rem;font-weight:600;}
  .faq-icon{
    width:30px;height:30px;border-radius:50%;border:1px solid var(--brown-line);flex-shrink:0;
    display:flex;align-items:center;justify-content:center;position:relative;transition:transform 0.4s var(--ease), background 0.3s ease;
  }
  .faq-icon::before,.faq-icon::after{content:"";position:absolute;background:var(--brown-deep);transition:transform 0.3s ease, opacity 0.3s ease;}
  .faq-icon::before{width:11px;height:1.4px;}
  .faq-icon::after{width:1.4px;height:11px;}
  .faq-item.open .faq-icon{background:var(--pink);border-color:var(--pink);}
  .faq-item.open .faq-icon::before,.faq-item.open .faq-icon::after{background:var(--paper);}
  .faq-item.open .faq-icon::after{opacity:0;}
  .faq-a{max-height:0;overflow:hidden;transition:max-height 0.45s var(--ease);}
  .faq-a p{padding-bottom:1.5rem;color:var(--brown-mid);line-height:1.65;max-width:640px;font-size:0.95rem;}

  /* ---------- CONTACT ---------- */
  .contact{background:var(--brown-deep);color:var(--cream);}
  .contact .eyebrow{color:var(--copper-light);}
  .contact .eyebrow::before{background:var(--copper-light);}
  .contact .section-head h2{color:var(--cream);}
  .contact .section-head p{color:rgba(244,233,216,0.68);}
  .contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem;margin-bottom:3rem;}
  .contact-card{
    background:rgba(244,233,216,0.05);border:1px solid rgba(244,233,216,0.12);border-radius:18px;padding:2rem;
    transition:transform 0.35s var(--ease), background 0.35s ease;
  }
  .contact-card:hover{transform:translateY(-6px);background:rgba(244,233,216,0.09);}
  .contact-card .ic{
    width:44px;height:44px;border-radius:12px;background:var(--pink);display:flex;align-items:center;justify-content:center;margin-bottom:1.1rem;
  }
  .contact-card .ic svg{width:20px;height:20px;stroke:var(--paper);}
  .contact-card h4{color:var(--cream);font-size:1.05rem;}
  .contact-card p{margin-top:0.5rem;color:rgba(244,233,216,0.65);font-size:0.9rem;line-height:1.6;}
  .contact-map{
    border-radius:20px;height:320px;overflow:hidden;position:relative;
    background:linear-gradient(135deg,#2E1B0F,#3B2416);border:1px solid rgba(244,233,216,0.12);
  }
  .contact-map img{width:100%;height:100%;object-fit:cover;opacity:0.55;}
  .contact-map .pin{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    display:flex;flex-direction:column;align-items:center;gap:0.5rem;
  }
  .pin-dot{width:18px;height:18px;border-radius:50%;background:var(--pink);box-shadow:0 0 0 8px rgba(194,68,99,0.25);animation:pulse 2s ease-in-out infinite;}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 8px rgba(194,68,99,0.25)}50%{box-shadow:0 0 0 14px rgba(194,68,99,0.08)}}
  .pin span{font-family:'JetBrains Mono',monospace;font-size:0.78rem;background:var(--paper);color:var(--brown-deep);padding:0.4rem 0.8rem;border-radius:100px;}

  /* ---------- FOOTER ---------- */
  footer{background:#1B0F07;color:rgba(244,233,216,0.65);padding:3.5rem 0 2rem;}
  .footer-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:2rem;padding-bottom:2.5rem;border-bottom:1px solid rgba(244,233,216,0.1);}
  .footer-brand .logo-text{color:var(--cream);}
  .footer-brand p{margin-top:0.9rem;max-width:280px;font-size:0.88rem;line-height:1.6;}
  .footer-cols{display:flex;gap:4rem;flex-wrap:wrap;}
  .footer-col h5{font-family:'JetBrains Mono',monospace;font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--copper-light);margin-bottom:1rem;}
  .footer-col a{display:block;font-size:0.88rem;margin-bottom:0.7rem;color:rgba(244,233,216,0.65);transition:color 0.3s ease;}
  .footer-col a:hover{color:var(--pink);}
  .footer-bottom{display:flex;justify-content:space-between;padding-top:1.6rem;font-size:0.78rem;flex-wrap:wrap;gap:0.8rem;}
  .social-row{display:flex;gap:0.8rem;}
  .social-row a{width:36px;height:36px;border-radius:50%;border:1px solid rgba(244,233,216,0.2);display:flex;align-items:center;justify-content:center;transition:all 0.3s ease;}
  .social-row a:hover{background:var(--pink);border-color:var(--pink);}
  .social-row svg{width:15px;height:15px;stroke:var(--cream);}

  /* ---------- responsive ---------- */
  @media (max-width:980px){
    .hero-grid{grid-template-columns:1fr;}
    .hero-visual{height:400px;order:-1;}
    .about-grid{grid-template-columns:1fr;}
    .about-gallery{height:340px;}
    .grid-3{grid-template-columns:1fr 1fr;}
    .grid-4{grid-template-columns:1fr 1fr;}
    .split{grid-template-columns:1fr;}
    .split.reverse .split-media{order:0;}
    .split-media{height:380px;}
    .split-copy{padding:3.5rem 6vw;}
    .moto-gallery{grid-template-columns:1fr 1fr;}
    .orders-grid{grid-template-columns:1fr;}
    .contact-grid{grid-template-columns:1fr;}
  }
  @media (max-width:720px){
    .nav-links{position:fixed;top:74px;left:0;right:0;background:var(--paper);flex-direction:column;padding:1.5rem 6vw;gap:1.2rem;
      box-shadow:var(--shadow);transform:translateY(-130%);opacity:0;transition:transform 0.4s var(--ease), opacity 0.3s ease;}
    .nav-links.open{transform:translateY(0);opacity:1;}
    nav ul{flex-direction:column;gap:1rem;}
    .menu-toggle{display:flex;}
    .grid-3,.grid-4{grid-template-columns:1fr;}
    .moto-gallery{grid-template-columns:1fr;}
    .form-row{grid-template-columns:1fr;}
    .form-field.full{grid-column:span 1;}
    .hero-stats{gap:1.4rem;flex-wrap:wrap;}
    .contact-grid{grid-template-columns:1fr;}
    .footer-top{flex-direction:column;}
  }
</style>
</head>
<body>

<header id="siteHeader">
  <a href="#top" class="logo">
    <div class="logo-badge"><span>N</span></div>
    <div class="logo-text">Naimas<small>Motor &amp; Custom Co.</small></div>
  </a>
  <nav>
    <div class="nav-links" id="navLinks">
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#featured">Featured</a></li>
        <li><a href="#bmw">Custom BMW</a></li>
        <li><a href="#mercedes">Mercedes</a></li>
        <li><a href="#moto">Motorcycles</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="#testimonials">Reviews</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>
  <a href="#order" class="nav-cta">Place an Order</a>
  <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu"><span></span><span></span><span></span></button>
</header>

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <div class="eyebrow">Naimas Company · Est. Garage Floor</div>
      <h1>Cars, tuned to<br><em>your</em> obsession.</h1>
      <p class="lede">From factory-fresh imports to one-off custom builds — Naimas hand-finishes every BMW, Mercedes, and motorcycle that leaves our floor. Pick a build sheet, place your order, drive it out.</p>
      <div class="hero-actions">
        <a href="#order" class="btn btn-primary">
          Start Your Order
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="#featured" class="btn btn-outline">Browse the Floor</a>
      </div>
      <div class="hero-stats">
        <div><strong>412+</strong><span>CARS DELIVERED</span></div>
        <div><strong>18 YRS</strong><span>ON THE FLOOR</span></div>
        <div><strong>4.9 / 5</strong><span>CUSTOMER RATING</span></div>
      </div>
    </div>
    <div class="hero-visual reveal-scale">
      <div class="ticket-frame frame-main">
        <img src="https://images.unsplash.com/photo-1555215695-3004980ad54e?q=80&w=1200&auto=format&fit=crop" alt="Custom pink and cream tuned BMW coupe on the showroom floor">
      </div>
      <div class="ticket-frame frame-second">
        <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=900&auto=format&fit=crop" alt="Mercedes sedan detail shot in warm garage light">
      </div>
      <div class="badge-float"><div class="dot"></div><span>BUILD #0412 · READY</span></div>
    </div>
  </div>
</section>

<div class="marquee-wrap">
  <div class="marquee">
    <span>BMW <em>CUSTOM SHOP</em></span><span>MERCEDES <em>DETAIL BAY</em></span><span>MOTORCYCLE <em>FAB STUDIO</em></span><span>FINANCING <em>AVAILABLE</em></span><span>NATIONWIDE <em>DELIVERY</em></span>
    <span>BMW <em>CUSTOM SHOP</em></span><span>MERCEDES <em>DETAIL BAY</em></span><span>MOTORCYCLE <em>FAB STUDIO</em></span><span>FINANCING <em>AVAILABLE</em></span><span>NATIONWIDE <em>DELIVERY</em></span>
  </div>
</div>

<section class="about section-pad" id="about">
  <div class="container about-grid">
    <div class="about-gallery reveal-scale">
      <img class="ag-1" src="https://images.unsplash.com/photo-1493238792000-8113da705763?q=80&w=900&auto=format&fit=crop" alt="Naimas mechanic working under the hood">
      <img class="ag-2" src="https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?q=80&w=800&auto=format&fit=crop" alt="Close up of chrome trim on a customized car">
    </div>
    <div class="about-copy reveal">
      <span class="stamp">Who We Are</span>
      <h2>A family garage that grew into the region's custom-build address.</h2>
      <p>Naimas Company started as a two-bay repair shop and became the place people bring their BMWs, Mercedes, and motorcycles when they want something the factory didn't offer. Every order runs through the same floor: strip, spec, build, detail, deliver.</p>
      <ul class="about-list">
        <li>In-house paint &amp; upholstery studio</li>
        <li>Certified BMW &amp; Mercedes technicians</li>
        <li>Motorcycle fabrication bay</li>
        <li>Transparent, itemized pricing</li>
      </ul>
      <a href="#order" class="btn btn-primary" style="margin-top:2.2rem;">
        Book a Consultation
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<section class="featured section-pad" id="featured">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Off The Floor Today</div>
      <h2>Featured Products</h2>
      <p>Ready-to-order builds fresh from the Naimas floor this week — each one comes with a full build sheet.</p>
    </div>
    <div class="grid-3">
      <article class="ticket reveal">
        <div class="ticket-perf"></div>
        <div class="ticket-photo">
          <span class="ticket-tag">Sedan</span>
          <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=800&auto=format&fit=crop" alt="Cream and brown customized sedan">
        </div>
        <div class="ticket-body">
          <div class="ticket-row"><h3>The Copperline Sedan</h3><span class="ticket-price">$38,400</span></div>
          <p>Two-tone cream and copper wrap, hand-stitched cognac interior, remapped 6-cylinder.</p>
          <div class="ticket-specs"><span>310 HP</span><span>Auto</span><span>4 Seats</span></div>
          <a href="#order" class="ticket-cta">Order this build <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>
      <article class="ticket reveal">
        <div class="ticket-perf"></div>
        <div class="ticket-photo">
          <span class="ticket-tag">Coupe</span>
          <img src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=800&auto=format&fit=crop" alt="Rose pink customized coupe">
        </div>
        <div class="ticket-body">
          <div class="ticket-row"><h3>The Blush Coupe</h3><span class="ticket-price">$44,900</span></div>
          <p>Matte blush pink body, forged 19" wheels, carbon splitter, sport exhaust note tuning.</p>
          <div class="ticket-specs"><span>402 HP</span><span>Manual</span><span>2 Seats</span></div>
          <a href="#order" class="ticket-cta">Order this build <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>
      <article class="ticket reveal">
        <div class="ticket-perf"></div>
        <div class="ticket-photo">
          <span class="ticket-tag">Cruiser</span>
          <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?q=80&w=800&auto=format&fit=crop" alt="Brown leather custom motorcycle cruiser">
        </div>
        <div class="ticket-body">
          <div class="ticket-row"><h3>The Sienna Cruiser</h3><span class="ticket-price">$16,750</span></div>
          <p>Saddle-brown leather seat, brass detailing, bobber tail, hand-painted cream tank.</p>
          <div class="ticket-specs"><span>96 HP</span><span>V-Twin</span><span>2 Seats</span></div>
          <a href="#order" class="ticket-cta">Order this build <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="split bmw-band" id="bmw">
  <div class="split-media reveal-scale">
    <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=1200&auto=format&fit=crop" alt="Custom BMW in the Naimas paint bay">
    <div class="split-caption"><div class="eyebrow">Naimas Custom BMW</div></div>
  </div>
  <div class="split-copy reveal">
    <div class="eyebrow">Bay 01</div>
    <h2>Custom BMW builds, spec'd to the last stitch.</h2>
    <p>Our BMW bay handles everything from a subtle cream respray to a full engine remap and widebody kit. Every build starts with a sit-down where we translate your reference photos into a real parts list.</p>
    <div class="spec-strip">
      <div><strong>2–6</strong><span>Weeks / Build</span></div>
      <div><strong>140+</strong><span>Parts Catalogued</span></div>
      <div><strong>5 Yr</strong><span>Paint Warranty</span></div>
    </div>
    <a href="#order" class="btn btn-primary">Design My BMW <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
  </div>
</section>

<section class="split reverse merc-band" id="mercedes">
  <div class="split-copy reveal">
    <div class="eyebrow">Bay 02</div>
    <h2>Mercedes, finished the way the badge deserves.</h2>
    <p>Naimas' Mercedes bay focuses on quiet luxury: nappa leather re-trims, ambient lighting retrofits, and factory-grade panel gaps. Nothing loud — just correct, down to the millimetre.</p>
    <div class="spec-strip">
      <div><strong>98%</strong><span>OEM-Match Paint</span></div>
      <div><strong>60+</strong><span>Leather Tones</span></div>
      <div><strong>3 Yr</strong><span>Interior Warranty</span></div>
    </div>
    <a href="#order" class="btn btn-primary">Design My Mercedes <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
  </div>
  <div class="split-media reveal-scale">
    <img src="https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?q=80&w=1200&auto=format&fit=crop" alt="Mercedes sedan interior detail with cream leather">
    <div class="split-caption"><div class="eyebrow">Naimas Mercedes Studio</div></div>
  </div>
</section>

<section class="section-pad moto-band" id="moto">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Bay 03 · Fabrication</div>
      <h2>Motorcycles built by hand, not by catalogue.</h2>
      <p>Our fabrication bay turns stock cruisers and standards into one-off machines — brass trim, hand-tooled leather, tanks painted in-house.</p>
    </div>
    <div class="moto-gallery">
      <figure class="reveal-scale"><img src="https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?q=80&w=800&auto=format&fit=crop" alt="Custom brown leather seat motorcycle"><figcaption>Bobber · Brass Trim</figcaption></figure>
      <figure class="reveal-scale"><img src="https://images.unsplash.com/photo-1449426468159-d96dbf08f19f?q=80&w=800&auto=format&fit=crop" alt="Cream tank custom motorcycle in workshop"><figcaption>Scrambler · Cream Tank</figcaption></figure>
      <figure class="reveal-scale"><img src="https://images.unsplash.com/photo-1601517990796-8ff03b0a06c4?q=80&w=800&auto=format&fit=crop" alt="Pink accent custom motorcycle detail"><figcaption>Cafe Racer · Blush Trim</figcaption></figure>
    </div>
    <div style="margin-top:2.4rem;text-align:center;">
      <a href="#order" class="btn btn-outline">Start My Motorcycle Build <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
    </div>
  </div>
</section>

<section class="pricing section-pad" id="pricing">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Build Sheets</div>
      <h2>Pricing</h2>
      <p>Three starting points. Every build is quoted exactly once we've reviewed your spec — no surprise line items.</p>
    </div>
    <div class="grid-3">
      <div class="price-card reveal">
        <span class="plan-name">Refresh</span>
        <h3>Detail &amp; Refresh</h3>
        <div class="amount"><b>$1,200</b><span>/ starting</span></div>
        <ul>
          <li>Full interior &amp; exterior detail</li>
          <li>Paint correction, single stage</li>
          <li>Minor trim &amp; upholstery repair</li>
          <li>48-hour turnaround</li>
        </ul>
        <a href="#order" class="btn btn-outline">Choose Refresh</a>
      </div>
      <div class="price-card featured reveal">
        <span class="ribbon">Most Ordered</span>
        <span class="plan-name">Custom Build</span>
        <h3>Full Custom Build</h3>
        <div class="amount"><b>$9,500</b><span>/ starting</span></div>
        <ul>
          <li>Full respray, any colour on the wheel</li>
          <li>Interior re-trim, leather or suede</li>
          <li>Wheel &amp; suspension package</li>
          <li>Engine tune consultation included</li>
        </ul>
        <a href="#order" class="btn btn-primary">Choose Custom Build</a>
      </div>
      <div class="price-card reveal">
        <span class="plan-name">Signature</span>
        <h3>Signature One-Off</h3>
        <div class="amount"><b>Quote</b><span>/ bespoke</span></div>
        <ul>
          <li>Ground-up rebuild, any make</li>
          <li>Bespoke fabrication &amp; badging</li>
          <li>Dedicated build manager</li>
          <li>Delivery event on completion</li>
        </ul>
        <a href="#order" class="btn btn-outline">Request Quote</a>
      </div>
    </div>
  </div>
</section>

<section class="testimonials section-pad" id="testimonials">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">From The Floor</div>
      <h2>Customer Testimonials</h2>
      <p>A few words from people who picked up their build this year.</p>
    </div>
    <div class="test-track">
      <div class="test-card reveal">
        <div class="stars">
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
